{
  "manifest_version": 3,
  "name": "Social Cleanup Toolkit",
  "version": "2.1.0",
  "description": "Herramientas de limpieza para redes sociales: Messenger y WhatsApp (eliminar/archivar chats) y TikTok (quitar compartidos).",
  "permissions": [
    "storage",
    "scripting"
  ],
  "action": {
    "default_title": "Social Cleanup Toolkit",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://www.messenger.com/*"
      ],
      "js": [
        "adapters/helpers.js",
        "adapters/messenger.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "adapters/helpers.js",
        "adapters/whatsapp.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.tiktok.com/*"
      ],
      "js": [
        "adapters/helpers.js",
        "adapters/tiktok.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://www.messenger.com/*",
    "https://web.whatsapp.com/*",
    "https://*.tiktok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}